{
  "expo": {
    "name": "xStory",
    "slug": "xStory",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash2.png",
      "tabletImage": "./assets/splash_ipad.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rueiyang.story",
      "scheme": "xstoryscheme",
      "jsEngine": "hermes",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "splash": {
        "image": "./assets/splash2_android.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.rueiyang.story",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "xstoryscheme"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "022de90a-4504-46f3-a0ad-af15dddb825f"
      }
    },
    "scheme": "xstoryscheme"
  }
}
